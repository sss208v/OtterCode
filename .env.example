# Generic API config. Works with Anthropic-compatible endpoints such as DeepSeek.
APIKEY=sk-your-api-key
API=https://api.deepseek.com/anthropic
MODEL=claude-sonnet-4-6

# Optional generic aliases supported by Otter Code.
# OTTER_CODE_API_KEY=sk-your-api-key
# OTTER_CODE_API_BASE=https://api.deepseek.com/anthropic

# Anthropic native config.
# ANTHROPIC_API_KEY=sk-ant-your-api-key
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI-compatible config.
# OPENAI_API_KEY=sk-your-api-key
# OPENAI_BASE_URL=https://your-openai-compatible-host/v1
# MODEL=gpt-4o

# ---- Skill evaluation (online_skill_eval) ----
# LLM judge 模型：pro 写 + flash 评，评测裁判用独立轻量模型（默认 deepseek-v4-flash）。
# OTTER_EVAL_JUDGE_MODEL=deepseek-v4-flash
# 晋升分数门槛：候选必须显著超过当前 champion 才晋升（默认 0.05，保守方向）。
# OTTER_EVAL_MIN_SCORE_DELTA=0.05
# 单次评测 LLM judge 调用预算上限，超限自动降级为纯 programmatic 评测（VeRO 预算控制）。
# OTTER_EVAL_MAX_JUDGE_CALLS=20
# 事件驱动增量评测：evolve/add 成功后自动后台评测（默认关闭，避免每次演化烧 token）。
# OTTER_EVAL_AUTO=0
